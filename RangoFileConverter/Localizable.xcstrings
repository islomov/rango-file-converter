    "This will permanently delete all converted %@ files. This action cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف جميع ملفات %@ المحوّلة نهائيًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি সমস্ত রূপান্তরিত %@ ফাইল স্থায়ীভাবে মুছে ফেলবে। এই ক্রিয়া পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto trvale smažete všechny převedené soubory %@. Tuto akci nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil permanent slette alle konverterede %@-filer. Denne handling kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle konvertierten %@-Dateien endgültig gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό θα διαγράψει μόνιμα όλα τα μετατρεμμένα αρχεία %@. Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently delete all converted %@ files. This action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará permanentemente todos los archivos %@ convertidos. Esta acción no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa pysyvästi kaikki muunnetut %@-tiedostot. Tätä toimintoa ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera définitivement tous les fichiers %@ convertis. Cette action est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תמחק לצמיתות את כל קבצי %@ שהומרו. לא ניתן לבטל פעולה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सभी कन्वर्ट की गई %@ फ़ाइलों को स्थायी रूप से हटा देगा। इस क्रिया को पूर्ववत नहीं किया जा सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez véglegesen törli az összes konvertált %@ fájlt. Ez a művelet nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus semua file %@ yang dikonversi secara permanen. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione eliminerà definitivamente tutti i file %@ convertiti. Non è possibile annullarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変換済みのすべての %@ ファイルが完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변환된 모든 %@ 파일이 영구적으로 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan memadam semua fail %@ yang ditukar secara kekal. Tindakan ini tidak boleh dibuat asal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil permanent slette alle konverterte %@-filer. Denne handlingen kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden alle geconverteerde %@-bestanden permanent verwijderd. Deze actie kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwałe usunięcie wszystkich skonwertowanych plików %@. Tej czynności nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso excluirá permanentemente todos os arquivos %@ convertidos. Esta ação não pode ser desfeita."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta va șterge permanent toate fișierele %@ convertite. Această acțiune nu poate fi anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все конвертированные файлы %@ будут удалены безвозвратно. Это действие нельзя отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta kommer permanent att radera alla konverterade %@-filer. Denna åtgärd kan inte ångras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบไฟล์ %@ ที่แปลงแล้วทั้งหมดอย่างถาวร ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, dönüştürülmüş tüm %@ dosyalarını kalıcı olarak silecektir. Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це назавжди видалить усі конвертовані файли %@. Цю дію неможливо скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa vĩnh viễn tất cả các tệp %@ đã chuyển đổi. Không thể hoàn tác hành động này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除所有已转换的 %@ 文件。此操作无法撤销。"
          }
        },
        "zh-Hant": {
