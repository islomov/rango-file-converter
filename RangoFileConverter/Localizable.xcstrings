    "·" : {
      "comment" : "A period used to separate two related items.",
      "isCommentAutoGenerated" : true
    },
    "%lld" : {
      "comment" : "A badge displaying the order number of a selected video in the audio merge picker view. The badge shows the number of the video in the order it was selected by the user.",
      "isCommentAutoGenerated" : true
    },
    "%lld × %lld" : {
      "comment" : "Displays the width and height of an image, optionally showing the original size and crop ratio. The first argument is the width of the image. The second argument is the height of the image. If there are changes (i.e., the image size is different from the pixel size), the third and fourth arguments are the width and height of the cropped image, respectively. If the image size is not zero, the",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld × %2$lld"
          }
        }
      }
    },
    "%lld FPS" : {
      "comment" : "A label displaying the current frame rate. The argument is the current frame rate as a floating-point number.",
      "isCommentAutoGenerated" : true
    },
    "%lld frames" : {
      "comment" : "A label displaying the total number of frames and the total duration of a GIF. The first argument is the total number of frames in the GIF. The second argument is the total duration of the GIF.",
      "isCommentAutoGenerated" : true
    },
    "%lld images" : {
      "comment" : "A label displaying the number of images and their size in pixels. The argument is the count of image URLs in the view's associated data.",
      "isCommentAutoGenerated" : true
    },
    "%lld of %lld" : {
      "comment" : "A footer displaying the current frame number and the total number of frames.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld of %2$lld"
          }
        }
      }
    },
    "%lld pages" : {
      "comment" : "A label displaying the number of pages in a PDF. The argument is the count of pages in the PDF.",
      "isCommentAutoGenerated" : true
    },
    "%lld selected" : {
      "comment" : "A label indicating how many items are currently selected in the audio merge picker.",
      "isCommentAutoGenerated" : true
    },
    "%lld%%" : {
      "comment" : "A text label displaying the current compression quality as a percentage. The value is dynamically updated as the user adjusts the slider.",
      "isCommentAutoGenerated" : true
    },
    "%lld°" : {
      "comment" : "A label displaying the current degree of rotation for an image. The value inside the curly braces is replaced with the current degree value.",
      "isCommentAutoGenerated" : true
    },
    "%lld×%lld" : {
      "comment" : "A label displaying the width and height of the preview image, formatted as a string.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld×%2$lld"
          }
        }
      }
    },
    "%lldpx" : {
      "comment" : "A label displaying the current width of the GIF preview. The argument is the current width of the GIF preview in pixels.",
