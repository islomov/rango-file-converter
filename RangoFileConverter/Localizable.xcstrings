        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالياً، يعالج Rango ملفاً واحداً في كل مرة لضمان أفضل جودة وأداء. حدد ملفاً، وقم بتحويله، ثم انتقل إلى الملف التالي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বর্তমানে, Rango সেরা গুণমান এবং কর্মক্ষমতা নিশ্চিত করতে একবারে একটি ফাইল প্রক্রিয়া করে। একটি ফাইল নির্বাচন করুন, রূপান্তর করুন, তারপর পরেরটিতে যান।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V současné době Rango zpracovává jeden soubor najednou, aby zajistil nejlepší kvalitu a výkon. Vyberte soubor, převeďte ho a pokračujte dalším."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I øjeblikket behandler Rango én fil ad gangen for at sikre den bedste kvalitet og ydeevne. Vælg en fil, konverter den, og fortsæt derefter med den næste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derzeit verarbeitet Rango eine Datei nach der anderen, um die beste Qualität und Leistung zu gewährleisten. Wähle eine Datei aus, konvertiere sie und fahre dann mit der nächsten fort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προς το παρόν, το Rango επεξεργάζεται ένα αρχείο τη φορά για να εξασφαλίσει την καλύτερη ποιότητα και απόδοση. Επιλέξτε ένα αρχείο, μετατρέψτε το και συνεχίστε με το επόμενο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Currently, Rango processes one file at a time to ensure the best quality and performance. Select a file, convert it, then proceed with the next one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualmente, Rango procesa un archivo a la vez para garantizar la mejor calidad y rendimiento. Selecciona un archivo, conviértelo y luego continúa con el siguiente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä hetkellä Rango käsittelee yhden tiedoston kerrallaan parhaan laadun ja suorituskyvyn varmistamiseksi. Valitse tiedosto, muunna se ja jatka seuraavaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actuellement, Rango traite un fichier à la fois pour garantir la meilleure qualité et performance. Sélectionnez un fichier, convertissez-le, puis passez au suivant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כרגע, Rango מעבד קובץ אחד בכל פעם כדי להבטיח את האיכות והביצועים הטובים ביותר. בחר קובץ, המר אותו ולאחר מכן המשך לקובץ הבא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान में, Rango सर्वोत्तम गुणवत्ता और प्रदर्शन सुनिश्चित करने के लिए एक बार में एक फ़ाइल को प्रोसेस करता है। एक फ़ाइल चुनें, उसे कन्वर्ट करें, फिर अगली फ़ाइल पर जाएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelenleg a Rango egyszerre egy fájlt dolgoz fel a legjobb minőség és teljesítmény érdekében. Válasszon ki egy fájlt, konvertálja, majd folytassa a következővel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ini, Rango memproses satu file pada satu waktu untuk memastikan kualitas dan kinerja terbaik. Pilih file, konversi, lalu lanjutkan dengan file berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attualmente, Rango elabora un file alla volta per garantire la migliore qualità e prestazioni. Seleziona un file, convertilo, quindi procedi con il successivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、Rangoは最高の品質とパフォーマンスを確保するために、一度に1つのファイルを処理します。ファイルを選択して変換し、次のファイルに進んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 Rango는 최고의 품질과 성능을 보장하기 위해 한 번에 하나의 파일을 처리합니다. 파일을 선택하고 변환한 후 다음 파일로 진행하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat masa ini, Rango memproses satu fail pada satu masa untuk memastikan kualiti dan prestasi terbaik. Pilih fail, tukar, kemudian teruskan dengan fail seterusnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For øyeblikket behandler Rango én fil om gangen for å sikre best mulig kvalitet og ytelse. Velg en fil, konverter den, og fortsett deretter med neste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Momenteel verwerkt Rango één bestand tegelijk voor de beste kwaliteit en prestaties. Selecteer een bestand, converteer het en ga dan verder met het volgende."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obecnie Rango przetwarza jeden plik naraz, aby zapewnić najlepszą jakość i wydajność. Wybierz plik, przekonwertuj go, a następnie przejdź do kolejnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualmente, o Rango processa um arquivo por vez para garantir a melhor qualidade e desempenho. Selecione um arquivo, converta-o e depois prossiga com o próximo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În prezent, Rango procesează câte un fișier pe rând pentru a asigura cea mai bună calitate și performanță. Selectați un fișier, convertiți-l, apoi continuați cu următorul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В настоящее время Rango обрабатывает по одному файлу для обеспечения наилучшего качества и производительности. Выберите файл, конвертируйте его, затем переходите к следующему."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För närvarande bearbetar Rango en fil åt gången för att säkerställa bästa kvalitet och prestanda. Välj en fil, konvertera den och fortsätt sedan med nästa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัจจุบัน Rango ประมวลผลทีละไฟล์เพื่อให้ได้คุณภาพและประสิทธิภาพที่ดีที่สุด เลือกไฟล์ แปลงไฟล์ แล้วดำเนินการต่อกับไฟล์ถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda Rango, en iyi kalite ve performansı sağlamak için aynı anda bir dosya işlemektedir. Bir dosya seçin, dönüştürün, ardından bir sonrakine geçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наразі Rango обробляє по одному файлу для забезпечення найкращої якості та продуктивності. Виберіть файл, конвертуйте його, потім переходьте до наступного."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện tại, Rango xử lý từng tệp một để đảm bảo chất lượng và hiệu suất tốt nhất. Chọn một tệp, chuyển đổi nó, rồi tiếp tục với tệp tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前，Rango 一次处理一个文件以确保最佳质量和性能。选择一个文件，转换它，然后继续处理下一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前，Rango 一次處理一個檔案以確保最佳品質和效能。選擇一個檔案，轉換它，然後繼續處理下一個。"
          }
        }
      }
    },
