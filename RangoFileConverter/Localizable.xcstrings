    "Latest section shows conversions from the last 5 minutes, including any currently in progress.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض القسم الأخير التحويلات من آخر 5 دقائق، بما في ذلك أي تحويلات قيد التنفيذ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সর্বশেষ বিভাগটি গত ৫ মিনিটের রূপান্তরগুলি দেখায়, যার মধ্যে বর্তমানে চলমান রূপান্তরও রয়েছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslední sekce zobrazuje konverze za posledních 5 minut, včetně probíhajících."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Seneste sektion viser konverteringer fra de sidste 5 minutter, inklusive igangværende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Abschnitt zeigt Konvertierungen der letzten 5 Minuten, einschließlich laufender."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρόσφατη ενότητα εμφανίζει μετατροπές από τα τελευταία 5 λεπτά, συμπεριλαμβανομένων τυχόν σε εξέλιξη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest section shows conversions from the last 5 minutes, including any currently in progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sección reciente muestra las conversiones de los últimos 5 minutos, incluidas las que están en curso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeisimmät-osio näyttää viimeisten 5 minuutin muunnokset, mukaan lukien käynnissä olevat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La section récente affiche les conversions des 5 dernières minutes, y compris celles en cours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלק האחרון מציג המרות מ-5 הדקות האחרונות, כולל כל ההמרות שעדיין בתהליך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीनतम अनुभाग पिछले 5 मिनट के रूपांतरण दिखाता है, जिसमें वर्तमान में प्रगति पर कोई भी शामिल है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legutóbbi szakasz az elmúlt 5 perc konvertálásait mutatja, beleértve a folyamatban lévőket is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagian terbaru menampilkan konversi dari 5 menit terakhir, termasuk yang sedang berlangsung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sezione recente mostra le conversioni degli ultimi 5 minuti, comprese quelle in corso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新セクションには過去5分間の変換が表示されます（進行中のものを含む）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 섹션은 현재 진행 중인 항목을 포함하여 최근 5분간의 변환을 보여줍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahagian terkini menunjukkan penukaran dari 5 minit terakhir, termasuk yang sedang berlangsung."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Siste seksjon viser konverteringer fra de siste 5 minuttene, inkludert pågående."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het recente gedeelte toont conversies van de afgelopen 5 minuten, inclusief lopende."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnia sekcja pokazuje konwersje z ostatnich 5 minut, w tym trwające."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A seção recente mostra as conversões dos últimos 5 minutos, incluindo as em andamento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Secțiunea recentă arată conversiile din ultimele 5 minute, inclusiv cele în curs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В разделе отображаются конвертации за последние 5 минут, включая текущие."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Senaste sektionen visar konverteringar från de senaste 5 minuterna, inklusive pågående."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่วนล่าสุดแสดงการแปลงจาก 5 นาทีที่ผ่านมา รวมถึงที่กำลังดำเนินอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son bölüm, devam edenler dahil son 5 dakikadaki dönüşümleri gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розділ показує конвертації за останні 5 хвилин, включаючи поточні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần mới nhất hiển thị các chuyển đổi trong 5 phút qua, bao gồm cả đang thực hiện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新部分显示过去5分钟的转换，包括正在进行的转换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最新區段顯示過去5分鐘的轉換，包括正在進行的轉換。"
          }
        }
      }
    },
