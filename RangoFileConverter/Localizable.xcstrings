    "Try adjusting your filters": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاول تعديل الفلاتر"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফিল্টার সামঞ্জস্য করার চেষ্টা করুন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste upravit filtry"
          }
        },
        "da": {
          "stringUnit": {
