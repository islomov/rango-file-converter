    "A new version of Rango is available. Please update to continue using the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوفر إصدار جديد من Rango. يرجى التحديث لمتابعة استخدام التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Rango-এর একটি নতুন সংস্করণ উপলব্ধ। অ্যাপটি ব্যবহার চালিয়ে যেতে অনুগ্রহ করে আপডেট করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K dispozici je nová verze aplikace Rango. Aktualizujte prosím, abyste mohli pokračovat v používání aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En ny version af Rango er tilgængelig. Opdater venligst for at fortsætte med at bruge appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neue Version von Rango ist verfügbar. Bitte aktualisiere die App, um sie weiterhin nutzen zu können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια νέα έκδοση του Rango είναι διαθέσιμη. Ενημερώστε για να συνεχίσετε να χρησιμοποιείτε την εφαρμογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new version of Rango is available. Please update to continue using the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una nueva versión de Rango disponible. Actualiza para seguir usando la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rangosta on saatavilla uusi versio. Päivitä jatkaaksesi sovelluksen käyttöä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle version de Rango est disponible. Veuillez mettre à jour pour continuer à utiliser l'app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרסה חדשה של Rango זמינה. אנא עדכן כדי להמשיך להשתמש באפליקציה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rango का एक नया संस्करण उपलब्ध है। ऐप का उपयोग जारी रखने के लिए कृपया अपडेट करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Rango új verziója elérhető. Kérjük, frissítsen az alkalmazás további használatához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi baru Rango tersedia. Perbarui untuk terus menggunakan aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È disponibile una nuova versione di Rango. Aggiorna per continuare a utilizzare l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Rangoの新しいバージョンが利用可能です。アプリを引き続き使用するにはアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Rango의 새 버전을 사용할 수 있습니다. 앱을 계속 사용하려면 업데이트해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi baharu Rango tersedia. Sila kemas kini untuk terus menggunakan aplikasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En ny versjon av Rango er tilgjengelig. Oppdater for å fortsette å bruke appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een nieuwe versie van Rango beschikbaar. Werk de app bij om deze te blijven gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostępna jest nowa wersja Rango. Zaktualizuj, aby kontynuować korzystanie z aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nova versão do Rango está disponível. Atualize para continuar usando o app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O nouă versiune a Rango este disponibilă. Actualizați pentru a continua să utilizați aplicația."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступна новая версия Rango. Обновите приложение, чтобы продолжить его использование."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ny version av Rango är tillgänglig. Uppdatera för att fortsätta använda appen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Rango เวอร์ชันใหม่พร้อมใช้งานแล้ว กรุณาอัปเดตเพื่อใช้งานแอปต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rango'nun yeni bir sürümü mevcut. Uygulamayı kullanmaya devam etmek için lütfen güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступна нова версія Rango. Оновіть, щоб продовжити користуватися додатком."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã có phiên bản mới của Rango. Vui lòng cập nhật để tiếp tục sử dụng ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rango 有新版本可用。请更新以继续使用该应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Rango 有新版本可用。請更新以繼續使用此應用程式。"
          }
        }
      }
    },
